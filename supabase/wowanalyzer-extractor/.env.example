# Copia este archivo a .env (mismo directorio) y rellena los valores reales.
# .env está en .gitignore del proyecto raíz — no se commitea.

SUPABASE_URL=https://qiniulkhivpvbjoquvon.supabase.co
# Dashboard de Supabase → Project Settings → API → service_role key (secreta,
# salta RLS — es la misma clase de credencial que ya usan las Edge Functions).
SUPABASE_SERVICE_ROLE_KEY=

# Las mismas credenciales que ya tienes en el .env.local de la raíz del proyecto.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
